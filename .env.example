# Elefante Environment Configuration
# Copy this file to .env and fill in your values
#
# NOTE: Elefante uses local embeddings (sentence-transformers) by default.
# No external API keys are required for core functionality.

# Optional: Custom data directory
# ELEFANTE_DATA_DIR=/path/to/data

# Optional: Log level override
# ELEFANTE_LOG_LEVEL=DEBUG

# Optional: Custom config file path
# ELEFANTE_CONFIG_PATH=/path/to/config.yaml

# Optional: MCP Server Port (if using HTTP mode)
# ELEFANTE_MCP_PORT=3000

# Optional: Embedding model override
# ELEFANTE_EMBEDDING_MODEL=thenlper/gte-base

# Optional: Device for embeddings (cpu, cuda, mps)
# ELEFANTE_DEVICE=cpu